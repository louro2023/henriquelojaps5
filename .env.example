# Vercel: mantenha a mesma senha administrativa que já utiliza.
ADMIN_PASSWORD=
# Cole aqui, como variável de ambiente na Vercel, o JSON completo da conta de serviço.
# Nunca publique a chave privada no repositório.
FIREBASE_SERVICE_ACCOUNT=
# Opcional no computador. Na Vercel, Firebase é selecionado automaticamente.
STORE_BACKEND=local
